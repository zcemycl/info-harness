# Copy to `.env` and fill in locally. Never commit `.env`.

# AWS Cognito (required for login)
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=
COGNITO_REGION=eu-west-2

# Cognito Identity Pool (required for S3 upload/read)
COGNITO_IDENTITY_POOL_ID=

# HC platform API
HC_API_BASE_URL=

# Optional NCBI E-utilities (PubMed); raises rate limits when set
NCBI_API_KEY=
# PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# LLM for Deep Agents (set one of these)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_FDA_SPECIALIST_MODEL=openai/gpt-4o-mini
# OPENROUTER_RESEARCH_PLANNER_MODEL=openai/gpt-4o-mini
# OPENROUTER_RESEARCH_WRITER_MODEL=openai/gpt-4o-mini
# OPENROUTER_RESEARCH_EVALUATOR_MODEL=openai/gpt-4o-mini
# RESEARCH_MAX_LOOPS=2
# RESEARCH_SPECIALIST_CONCURRENCY=3
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# FDA_SPECIALIST_RECURSION_LIMIT=60
# FDA_SPECIALIST_MAX_LOOPS=3
# ICD_TA_SPECIALIST_MAX_LOOPS=3
# FDA_EVAL_PASS_THRESHOLD=3.5
# FDA_AGENT_TOOL_MAX_CHARS=8000

# Chat API (local directory when the bucket is empty; S3 when set)
# CHAT_DATA_DIR=data/chats
# CHAT_S3_BUCKET=
# CHAT_S3_PREFIX=
# Lambda only: async self-invoke of this function for research (defaults to the function name)
# RESEARCH_FUNCTION_NAME=
# CHAT_INLINE_RESEARCH=1
# CORS_ALLOW_ORIGINS=*
