# Cognito (same pool as the API). Copy to web/.env.local — do not commit that file.

VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=
VITE_COGNITO_REGION=eu-west-2
VITE_COGNITO_IDENTITY_POOL_ID=
VITE_API_BASE_URL=http://127.0.0.1:8080
# Production only: agentic-chat-stream Function URL for GET /runs/{id}/events/stream.
# Leave empty locally so REST and SSE both use VITE_API_BASE_URL.
VITE_AGENTIC_CHAT_STREAM_URL=
VITE_APP_BASENAME=
